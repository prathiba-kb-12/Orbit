{
  "functions": {
    "api/*.ts": {
      "includeFiles": "firebase-applet-config.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/unstick",
      "destination": "/api/replan?mode=unstick"
    },
    {
      "source": "/api/win-note",
      "destination": "/api/insights?mode=win-note"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
